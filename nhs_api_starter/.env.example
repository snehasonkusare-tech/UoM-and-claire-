# sandbox | integration | production
NHS_ENV=sandbox

# All fetched files are written below this project-relative directory.
NHS_DATA_DIR=./data

# Required in integration/production for the NHS Website Content API.
NHS_CONTENT_API_KEY=

# Required in integration/production for Directory of Healthcare Services v3.
NHS_DOHS_API_KEY=

# Legacy Directory of Services – Urgent & Emergency Care REST.
# These are DoS account credentials, not your NHS API Platform API key.
NHS_DOS_USERNAME=
NHS_DOS_PASSWORD=
NHS_DOS_BASE=https://usertest.directoryofservices.nhs.uk/app/controllers/api/v1.0

# MySQL connection used by db/ingest_dohs_to_mysql.py and
# symptoms_db/ingest_symptoms_to_mysql.py (same server, separate databases).
# Run db/schema.sql and symptoms_db/schema.sql in MySQL Workbench first to
# create the nhs_directory and nhs_symptoms databases.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nhs_directory
SYMPTOMS_DB_NAME=nhs_symptoms
